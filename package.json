{
  "name": "guineadog",
  "version": "1.0.0",
  "description": "DX toolkit and automation scripts",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf dist packages/normalize-typography/dist",
    "type-check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "format": "prettier --write .",
    "knip": "knip",
    "lint": "eslint .",
    "lint:deps": "depcruise packages --config .dependency-cruiser.cjs",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "nrm-tpgr": "node packages/normalize-typography/dist/index.js",
    "nrm-tpgr:check": "npm run nrm-tpgr -- --check",
    "prepare": "husky",
    "test": "npm test --workspaces --if-present"
  },
  "lint-staged": {
    "*": [
      "prettier --check",
      "npm run nrm-tpgr:check"
    ],
    "*.{js,mjs,ts,tsx}": "eslint --max-warnings 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuineaDog/GuineaDog.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/GuineaDog/GuineaDog/issues"
  },
  "homepage": "https://github.com/GuineaDog/GuineaDog#readme",
  "engines": {
    "node": "^22 || ^24"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.4",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "knip": "^6.24.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}
