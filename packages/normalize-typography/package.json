{
  "name": "@guineadog/normalize-typography",
  "version": "0.3.3",
  "description": "CLI tool to replace non-standard typography (smart quotes, dashes) with standard ASCII equivalents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "normalize-typography": "dist/index.js",
    "nrm-tpgr": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "test": "node --import tsx --test *.test.ts",
    "build": "tsc --project tsconfig.json",
    "pack": "npm pack --pack-destination ./dist",
    "prepublishOnly": "npm run clean && npm run build && npm run pack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuineaDog/GuineaDog.git",
    "directory": "packages/normalize-typography"
  },
  "bugs": {
    "url": "https://github.com/GuineaDog/GuineaDog/issues"
  },
  "homepage": "https://github.com/GuineaDog/GuineaDog/tree/main/packages/normalize-typography#readme",
  "keywords": [
    "typography",
    "dashes",
    "quotes",
    "smart-quotes",
    "lint",
    "maintenance"
  ],
  "author": "Artem Grodetskii",
  "license": "MIT",
  "engines": {
    "node": "^22 || ^24"
  }
}
